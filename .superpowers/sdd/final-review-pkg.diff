+		Scope: "namespace", Namespace: "ns-a", Enabled: true,
+	}
+	task := inspModel.InspTask{Name: "命名空间巡检", Cluster: &cluster, Rules: []inspModel.InspRule{rule}}
+	if err := db.Create(&task).Error; err != nil {
