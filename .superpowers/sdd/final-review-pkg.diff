+	if err := global.GVA_DB.WithContext(ctx).Model(&inspModel.InspTaskRule{}).Where("insp_rule_id = ?", id).Count(&count).Error; err != nil {
+		return err
+	}
+	if count > 0 {
+		return fmt.Errorf("规则已绑定巡检任务，不能删除")
